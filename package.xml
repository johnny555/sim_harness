<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_harness</name>
  <version>1.0.0</version>
  <description>
    Pytest plugin and Python test harness for ROS 2 simulation testing.
    Provides a SimTestFixture, a check-function library
    (sensors / motion / services / nav2 / perception), launch helpers,
    and a @pytest.mark.requirement marker that exports results to a
    Jama-importable spreadsheet (--jama-xlsx). Also installs a small
    set of bridge nodes (tf_relay, twist_to_twist_stamped,
    gps_map_odom_node) and the standalone ekf_wrapper_node C++ helper.
  </description>
  <maintainer email="john@example.com">John</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system: ament_cmake_python is sufficient since the only C++ left
       is the standalone ekf_wrapper_node executable. -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Python runtime -->
  <depend>rclpy</depend>

  <!-- ROS 2 message types used by the Python check-function library -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>controller_manager_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- EKF wrapper node (sim-time deadlock workaround) -->
  <depend>rclcpp</depend>
  <depend>robot_localization</depend>
  <depend>diagnostic_updater</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Launch testing -->
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>launch_testing</depend>
  <depend>launch_testing_ros</depend>
  <exec_depend>launch_testing_ament_cmake</exec_depend>

  <!-- launch_pytest powers the gazebo_world fixture (ROS 2 native pytest) -->
  <exec_depend>launch_pytest</exec_depend>

  <!-- Pytest plugin: openpyxl powers the Jama xlsx exporter -->
  <exec_depend>python3-openpyxl</exec_depend>

  <!-- Python Testing -->
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-cov</test_depend>
  <test_depend>python3-hypothesis</test_depend>

  <!-- Linting (optional) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <!-- Integration test dependencies (optional) -->
  <test_depend condition="$ROS_DISTRO == jazzy">turtlebot3_gazebo</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
